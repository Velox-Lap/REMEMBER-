# Public browser configuration for PROJECT 29.12.
# Obtain the values from the connected Supabase project and configure the same
# variable names in Vercel Preview and Production environments.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IMPORTANT:
# - These are public client configuration values, not privileged credentials.
# - NEVER place SUPABASE_SERVICE_ROLE_KEY or any private key in NEXT_PUBLIC_*.
# - Keep .env.local out of Git; do not commit secrets or personal data.
